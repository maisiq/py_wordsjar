# Скопируйте этот файл в .env (он в .gitignore) и правьте под себя.

# Базовый URL API. По умолчанию /api/v1 — запросы идут на тот же origin:
# в разработке их проксирует Vite (см. vite.config.js), в продакшене — nginx.
# Абсолютный URL (https://api.example.com/api/v1) нужен только если API живёт
# на другом домене — тогда на бэкенде должен быть разрешён CORS для этого origin.
VITE_API_BASE_URL=/api/v1

# Куда Vite проксирует /api/v1 в режиме разработки.
VITE_DEV_PROXY_TARGET=http://localhost:8080